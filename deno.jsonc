{
  "name": "@webluabridge/webluabridge",
  "version": "0.2.0",
  "exports": "./mod.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "wasmoon": "npm:wasmoon@1.16.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "esbuild": "npm:esbuild@0.27.3"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    // Enable experimental decorators for Lua class definitions
    "experimentalDecorators": true
  },
  "tasks": {
    "check": "deno check mod.ts scripts/build_bundle.ts",
    "test": "deno test -A tests",
    "bundle": "deno run -A scripts/build_bundle.ts",
    "build": "deno task check && deno task test && deno task bundle",
    "lint": "deno lint",
    "fmt": "deno fmt"
  }
}
