{
  "name": "@webluabridge/webluabridge",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    // Enable experimental decorators for Lua class definitions
    "experimentalDecorators": true
  },
  "tasks": {
    "check": "deno check mod.ts src/lua/bridge.ts src/lua/bindings.ts src/lua/lua_class.ts src/bindings/global.ts src/bindings/regex.ts src/bindings/json.ts src/bindings/timers.ts examples/basic-run.ts examples/environment-plugin.ts examples/events-bridge.ts examples/lifecycle-mainloop.ts tests/bridge.api.test.ts tests/bridge.bindings.test.ts tests/bridge.execute.test.ts tests/bridge.environment-events.test.ts tests/bridge.lifecycle.test.ts tests/examples.e2e.test.ts",
    "test": "deno test -A tests",
    "bundle": "deno run -A scripts/build_bundle.ts",
    "build": "deno task check && deno task bundle",
    "lint": "deno lint",
    "fmt": "deno fmt"
  }
}
